    {
      "id": 6,
      "type": "timeseries",
      "title": "Quality features: error and discard rate",
      "description": "Near zero almost always. A z-score against a near-constant metric is meaningless, which is why these want a fixed threshold on the raw count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
