        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo\\d*|docker.*|veth.*|br-.*|utun.*|bridge.*|awdl.*|llw.*|gif.*|stf.*|anpi.*|ap[0-9].*\"}[1m])",
          "legendFormat": "{{device}}",
