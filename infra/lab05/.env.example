# One source point represents five minutes. At 300x, one point is replayed per second.
LAB05_REPLAY_SPEED=300

# Host ports. Change these only when the default port is already occupied.
LAB05_REPLAYER_PORT=9200
LAB05_PROMETHEUS_PORT=9090
LAB05_ALERTMANAGER_PORT=9093
LAB05_RECEIVER_PORT=9300
LAB05_GRAFANA_PORT=3000
