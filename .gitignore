# OS and filesystem noise
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
Thumbs.db
Desktop.ini

# Python caches and build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local Python and Conda environments
.venv/
venv/
env/
.conda/

# Local configuration and secrets
.env
.env.*
!.env.example

# Jupyter runtime files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Editor and runtime scratch
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# Prometheus TSDB. Starting Prometheus from the repo root without --storage.tsdb.path
# makes it write its blocks, WAL and lock file into ./data next to the course CSV.
# The datasets below are committed; anything Prometheus writes is not.
data/wal/
data/chunks_head/
data/queries.active
data/lock
data/[0-9A-Z][0-9A-Z]*/

# Notebook runtime outputs — written to outputs/ during lab runs, not source data.
# Source datasets live in data/synthetic/ and data/sample/ (both committed).
# .gitkeep files anchor the directories in git; all generated content is ignored.
outputs/workshop/*
!outputs/workshop/.gitkeep
outputs/setup/*

# Slide decks. The deck lives outside this repo in ../slide/ and is rebuilt from
# slide/build_deck.py; binary Office files do not belong in the course history.
*.pptx
*.pptx#
~$*.pptx
