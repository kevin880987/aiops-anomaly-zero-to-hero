<mxfile host="app.diagrams.net" type="device">
  <diagram name="lab00_pipeline" id="lab00-pipeline">
    <mxGraphModel dx="1360" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 00：一條線，從作業系統的 counter 到值班室看得到的告警" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=18;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="這門課只寫其中一個方框。其餘四個是官方元件，照它們原本的用法接起來。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=13;fontColor=#5A6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1000" height="24" as="geometry" />
        </mxCell>

        <mxCell id="signal" value="&lt;b&gt;作業系統與網卡&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#5A6472&quot;&gt;bytes、packets、errors&lt;br/&gt;只增不減的 counter&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#98A2B3;strokeWidth=1.5;fontFamily=Georgia;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="exporter" value="&lt;b&gt;node_exporter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#5A6472&quot;&gt;官方 binary，:9100&lt;br/&gt;曝露 /metrics&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#98A2B3;strokeWidth=1.5;fontFamily=Georgia;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="310" y="170" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#5A6472&quot;&gt;:9090，每 5 秒抓一次&lt;br/&gt;存時間序列、評估規則&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#3B7DD8;strokeWidth=2.5;fontFamily=Georgia;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="600" y="165" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="detector" value="&lt;b&gt;detector.py&lt;/b&gt;&lt;span style=&quot;color:#E0752D&quot;&gt;　← 這門課寫的&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#5A6472&quot;&gt;:9200，每 15 秒一輪&lt;br/&gt;滾動基線 → 偏離分數 → Gauge&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#E0752D;strokeWidth=3;fontFamily=Georgia;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="560" y="420" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="grafana" value="&lt;b&gt;Grafana dashboard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#5A6472&quot;&gt;:3000，原始速率與分數&lt;br/&gt;畫在同一張圖上&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#98A2B3;strokeWidth=1.5;fontFamily=Georgia;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1030" y="95" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="alerts" value="&lt;b&gt;告警&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#5A6472&quot;&gt;Normal → Pending → Firing&lt;br/&gt;for 決定要撐多久才算數&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEDF0;strokeColor=#D6455D;strokeWidth=2.5;fontFamily=Georgia;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1030" y="245" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="counter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98A2B3;strokeWidth=2;fontFamily=Georgia;fontSize=11;fontColor=#5A6472;verticalAlign=bottom;labelBackgroundColor=none;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="signal" target="exporter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="scrape，5 秒" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98A2B3;strokeWidth=2;fontFamily=Georgia;fontSize=11;fontColor=#5A6472;verticalAlign=bottom;labelBackgroundColor=none;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="exporter" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="PromQL 查詢" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B7DD8;strokeWidth=2;fontFamily=Georgia;fontSize=11;fontColor=#3B7DD8;verticalAlign=bottom;labelBackgroundColor=none;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="grafana">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e4" value="評估 alerts.yml" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6455D;strokeWidth=2;fontFamily=Georgia;fontSize=11;fontColor=#D6455D;verticalAlign=bottom;labelBackgroundColor=none;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="alerts">
          <mxGeometry x="-0.45" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E0752D;strokeWidth=3;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.321;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="detector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E0752D;strokeWidth=3;endArrow=blockThin;endFill=1;exitX=0.679;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="detector" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="l5" value="&lt;b&gt;①&lt;/b&gt; detector 查 Prometheus&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rate(node_network_receive_bytes_total)&lt;br/&gt;走的是 HTTP API，跟 Grafana 一樣&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Georgia;fontSize=12;fontColor=#E0752D;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="450" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l6" value="&lt;b&gt;②&lt;/b&gt; Prometheus 抓 detector&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;aiops_traffic_score 就此進到 Prometheus，&lt;br/&gt;跟 node_exporter 的指標平起平坐&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=12;fontColor=#E0752D;" vertex="1" parent="1">
          <mxGeometry x="790" y="300" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;分數回到 Prometheus 之後就是一般指標。&lt;/b&gt;Grafana 的 panel 與 alerts.yml 的規則都不需要知道它是 Python 算的，所以上線的時候換掉的是 detector.py 裡的演算法，&lt;br/&gt;不是下游的任何一格。Lab 01 與 Lab 02 因此只做一件事：把 detector.py 裡那個算分數的函式，換成撐得住真實流量的版本。" style="text;html=1;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=12;fontColor=#5A6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1290" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
