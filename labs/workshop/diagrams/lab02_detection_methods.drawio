<mxfile host="app.diagrams.net" type="device">
  <diagram name="lab02_detection_methods" id="lab02-detection-methods">
    <mxGraphModel dx="1240" dy="440" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 02：三種判準，三種付得起的代價" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=18;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="沒有一種判準在所有形狀上都對。選哪一種，取決於你要看見什麼，以及願意漏掉什麼。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=13;fontColor=#5A6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b style=&quot;font-size:15px&quot;&gt;固定門檻&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#3B7DD8&quot;&gt;value &amp;gt; X → 異常&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;color:#5A6472&quot;&gt;&lt;b&gt;好處&lt;/b&gt;　寫得出來，也講得清楚為什麼是這個數字&lt;br/&gt;&lt;br/&gt;&lt;b&gt;代價&lt;/b&gt;　完全不理會這條線平常起伏多大&lt;br/&gt;&lt;br/&gt;&lt;b&gt;用在&lt;/b&gt;　頻寬、CPU 這種有硬上限的量，&lt;br/&gt;　　　以及離散度塌成 0 的欄位（錯誤率）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#98A2B3;strokeWidth=1.5;fontFamily=Georgia;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="360" height="195" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b style=&quot;font-size:15px&quot;&gt;統計基線&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#3B7DD8&quot;&gt;偏離基線 &amp;gt; N 個離散度 → 異常&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;color:#5A6472&quot;&gt;&lt;b&gt;好處&lt;/b&gt;　門檻跟著這條線自己的規模走，&lt;br/&gt;　　　五個量級不同的 port 共用一個數字&lt;br/&gt;&lt;br/&gt;&lt;b&gt;代價&lt;/b&gt;　基線要暖機；而且要抓的那個尖峰，&lt;br/&gt;　　　會自己抬高用來抓它的那個分母&lt;br/&gt;&lt;br/&gt;&lt;b&gt;用在&lt;/b&gt;　突發尖峰，這門課的預設&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#3B7DD8;strokeWidth=2.5;fontFamily=Georgia;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="360" height="195" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b style=&quot;font-size:15px&quot;&gt;變點偵測&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#3B7DD8&quot;&gt;水位整段換一層 → 異常&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;color:#5A6472&quot;&gt;&lt;b&gt;好處&lt;/b&gt;　看得見沒有尖峰的那一種故障：&lt;br/&gt;　　　抬高之後一直維持在新的水位&lt;br/&gt;&lt;br/&gt;&lt;b&gt;代價&lt;/b&gt;　反應慢是設計出來的，不是缺陷&lt;br/&gt;&lt;br/&gt;&lt;b&gt;用在&lt;/b&gt;　緩慢漂移、狀態換檔&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#98A2B3;strokeWidth=1.5;fontFamily=Georgia;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="360" height="195" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;三種判準都只產生分數。&lt;/b&gt;分數越線叫 breach，連續幾個 breach 才成為 label，label 通過政策（最小音量、維護時窗、合併）之後才是一則告警。&lt;br/&gt;判準選錯會漏掉事件；政策設錯會把值班室吵到不再看告警。這兩件事要分開量：前者用 event recall，後者用每天送出去的告警數。" style="text;html=1;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=12;fontColor=#5A6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1160" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
