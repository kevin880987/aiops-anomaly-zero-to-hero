# 把這個檔案複製成同一層的 .env，再改你要改的那幾行。沒有 .env 也能跑，會用預設值。
#
#   cp .env.example .env        # macOS / Linux
#   copy .env.example .env      # Windows

# 重播倍速。兩份 case 的長度不一樣，所以各有各的倍速，讓兩張儀表板一輪都大約八分鐘。
# Lab 06 的那兩晚共 41 小時，Lab 07 的事故窗約 8 小時。
WEEK6_REPLAY06_SPEED=300
WEEK6_REPLAY07_SPEED=60

# Host ports。只有在預設的 port 已經被佔用的時候才需要改。
# 最常見的情況是前幾週課用 brew 或 systemd 裝的 Grafana 還佔著 3000。
WEEK6_REPLAYER06_PORT=8011
WEEK6_REPLAYER07_PORT=8010
WEEK6_PROMETHEUS_PORT=9090
WEEK6_GRAFANA_PORT=3000
